#!/usr/bin/env bash
# gopro-cam: put the GoPro on a v4l2loopback node so any app can pick it as a webcam.
#
# The HERO 9-13 have a webcam mode, but only macOS and Windows get a driver for it.
# Over USB the camera appears as an ethernet device; you ask it over HTTP to start
# streaming, and it sends MPEG-TS to UDP 8554. The `gopro` script in this repo
# (Joshua Schmid's, Apache-2.0) does that part. This wrapper adds the pieces that
# make it pleasant day to day: it finds that script wherever it lives, it keeps
# one video node, it can blur your background on the way through, and it reminds
# you that the camera's microphone is NOT carried over this link.
#
#   gopro-cam start [1080|720|480] [linear|narrow|wide|superview]
#   gopro-cam stop
#   gopro-cam status
#   gopro-cam setup [res] [fov]   just the root half: module + camera stream
#   gopro-cam stream              just the user half: frames -> video device
#   gopro-cam nudge               make PipeWire apps (GNOME Camera) notice it
#
#   --blur / --no-blur            override the configured background blur
#   --strength N                  blur radius, 1-30
#
# `start` is `setup` then `stream`, and `stream` holds the terminal for as long
# as the camera is live. Only `setup` needs root, which is why they can be run
# apart: the GUI elevates that half alone.
#
# On the camera first: Preferences -> Connections -> USB Connection -> GoPro
# Connect. Left on MTP it mounts as a disk and nothing here can see it.
#
# Optional ~/.config/gopro-panel/config (KEY=value, one per line):
#   VIDEO_NR=42          the /dev/videoN to create
#   FOV=narrow           default field of view
#   RESOLUTION=1080      default resolution
#   BLUR=off             blur the background by default
#   BLUR_STRENGTH=8      how much
#   MIC_MATCH=fifine     substring of the PulseAudio source you use as a mic
#   GOPRO_SCRIPT=...     upstream's script, if it isn't in /usr/local/sbin
#
# SPDX-License-Identifier: MIT
set -uo pipefail

# Who this is really being run for. pkexec and sudo hand us root with root's
# $HOME and no XDG_RUNTIME_DIR, so `setup` and `stop` would otherwise read
# /root/.config and look for the worker's pidfile in /run/user/0.
OWNER_UID=${PKEXEC_UID:-${SUDO_UID:-$(id -u)}}
OWNER_HOME=$(getent passwd "$OWNER_UID" | cut -d: -f6)
: "${OWNER_HOME:=$HOME}"
RUNTIME_BASE=/run/user/$OWNER_UID
[ -d "$RUNTIME_BASE" ] || RUNTIME_BASE=${XDG_RUNTIME_DIR:-/tmp}

CONFIG=${GOPRO_PANEL_CONFIG:-${XDG_CONFIG_HOME:-$OWNER_HOME/.config}/gopro-panel/config}
# shellcheck disable=SC1090
[ -r "$CONFIG" ] && . "$CONFIG"

VIDEO_NR=${VIDEO_NR:-42}
DEV=/dev/video$VIDEO_NR
MIC_MATCH=${MIC_MATCH:-}
FOV=${FOV:-linear}
RESOLUTION=${RESOLUTION:-1080}
BLUR=${BLUR:-off}
BLUR_STRENGTH=${BLUR_STRENGTH:-8}

SELF_DIR=$(dirname "$(readlink -f "$0")")
DATA_DIR=${XDG_DATA_HOME:-$OWNER_HOME/.local/share}

# Find the upstream script: next to us in a clone, installed, or pointed at by
# $GOPRO_SCRIPT. Resolving it from our own path (not $HOME) matters because
# gopro-panel runs `setup` under pkexec, where $HOME is /root.
GOPRO_BIN=
for candidate in "${GOPRO_SCRIPT:-}" "$SELF_DIR/../gopro" "$SELF_DIR/gopro" \
                 /usr/local/sbin/gopro /usr/sbin/gopro; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    GOPRO_BIN=$(readlink -f "$candidate"); break
  fi
done

# The blur worker needs mediapipe, which install.sh puts in its own venv so it
# cannot collide with the system's Python packages.
BLUR_PY=
for candidate in "$SELF_DIR/../gopro_blur.py" "$DATA_DIR/gopro-panel/gopro_blur.py"; do
  [ -f "$candidate" ] && { BLUR_PY=$(readlink -f "$candidate"); break; }
done
PYTHON=python3
[ -x "$DATA_DIR/gopro-panel/venv/bin/python" ] && PYTHON=$DATA_DIR/gopro-panel/venv/bin/python

RUNTIME_DIR=$RUNTIME_BASE/gopro-panel
PIDFILE=$RUNTIME_DIR/worker.pid

# The worker's pid, and only if that pid really is the worker. Matching on the
# name instead -- pkill -f gopro_blur.py -- would also hit an editor that has
# the file open, and this one sends signals.
worker_pid() {
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [ -n "$pid" ] || return 1
  grep -qa gopro_blur.py "/proc/$pid/cmdline" 2>/dev/null || return 1
  echo "$pid"
}

as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[0;90m%s\033[0m\n' "$*"; }

# The camera hands us a /24 over USB ethernet and answers on .51 of it.
camera_ip() {
  ip -4 -oneline addr 2>/dev/null | awk '
    $2 ~ /^enx/ {
      for (i = 1; i < NF; i++)
        if ($i == "inet") { split($(i+1), a, "/"); split(a[1], o, "."); 
                            print o[1] "." o[2] "." o[3] ".51"; exit }
    }'
}

mic_source() {
  [ -n "$MIC_MATCH" ] || return 0
  pactl list short sources 2>/dev/null | awk -v m="$MIC_MATCH" \
    'tolower($2) ~ tolower(m) && $2 !~ /\.monitor$/ {print $2; exit}'
}

# ------------------------------------------------------------------ arguments
ACTION=${1:-start}
[ $# -gt 0 ] && shift
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
    --blur)      BLUR=on ;;
    --no-blur)   BLUR=off ;;
    --strength)  BLUR_STRENGTH=$2; shift ;;
    -*)          red "unknown option: $1"; exit 2 ;;
    *)           POSITIONAL+=("$1") ;;
  esac
  shift
done
RES=${POSITIONAL[0]:-$RESOLUTION}
VIEW=${POSITIONAL[1]:-$FOV}

do_setup() {
  if ! modinfo v4l2loopback >/dev/null 2>&1; then
    red "v4l2loopback is not installed."
    echo "  sudo apt install -y v4l2loopback-dkms v4l-utils     # Debian/Ubuntu"
    echo "  sudo dnf install -y v4l2loopback v4l-utils          # Fedora"
    exit 1
  fi
  if [ -z "$GOPRO_BIN" ]; then
    red "The upstream 'gopro' script is missing."
    dim "Run this from a clone of the repo, or set GOPRO_SCRIPT=/path/to/gopro."
    exit 1
  fi
  if ! lsusb | grep -qi gopro; then
    red "No GoPro on USB."
    dim "Plug it in, power it on, and set Preferences -> Connections -> USB Connection"
    dim "to 'GoPro Connect'. On MTP the camera is a disk, not a camera."
    exit 1
  fi
  # No -a: upstream would start its own ffmpeg straight into the video device,
  # and then there is nowhere to put the blur. Without it, upstream loads the
  # module and starts the camera streaming to UDP, which is what `stream` wants.
  #
  # --video-number in long form on purpose: upstream gives both --non-interactive
  # and --video-number the short flag -n, and --non-interactive is matched first,
  # so "-n 42" silently means "non-interactive" and leaves 42 as a stray argument.
  green "Starting webcam mode -> $DEV"
  as_root "$GOPRO_BIN" webcam -p enx -n -r "$RES" -f "$VIEW" --video-number "$VIDEO_NR" \
    || return 1
  relabel_device
}

# Upstream builds the module argument as card_label='GoPro'$N and runs it
# unquoted, so the module receives the quotes literally: the camera shows up as
# 'GoPro'42, and PipeWire gives up and calls it "Unknown device". Reload with a
# clean label. Nothing is attached to the node yet at this point, so the unload
# is safe; if it is not, leave what upstream made rather than end up with none.
relabel_device() {
  [ "$(cat "/sys/class/video4linux/video$VIDEO_NR/name" 2>/dev/null)" = "GoPro" ] && return 0
  as_root modprobe -rf v4l2loopback 2>/dev/null || {
    dim "Left the device label as upstream set it (module busy)."; return 0; }
  if ! as_root modprobe v4l2loopback exclusive_caps=1 card_label=GoPro \
                video_nr="$VIDEO_NR" 2>/dev/null; then
    red "Could not reload v4l2loopback — no video device. Run 'gopro-cam stop' and retry."
    return 1
  fi
}

# GNOME's Snapshot and Cheese take cameras from PipeWire rather than reading
# V4L2 themselves, and PipeWire only registers a camera source if the node
# advertised capture when it probed it. With exclusive_caps=1 -- which Chrome
# insists on -- a loopback node is output-only until something feeds it, so a
# node created before the stream started never becomes a source. Re-probing is
# not exposed as an API; restarting WirePlumber is, and needs no root.
do_nudge() {
  if ! command -v systemctl >/dev/null; then
    red "No systemctl here; restart your PipeWire session manually."
    return 1
  fi
  systemctl --user restart wireplumber || return 1
  green "WirePlumber restarted — PipeWire apps should list the GoPro now."
  dim "Chrome, Firefox, Zoom and OBS read V4L2 directly and never needed this."
}

do_stream() {
  if [ -z "$BLUR_PY" ]; then
    red "gopro_blur.py is missing — run install.sh, or stream from a clone."
    exit 1
  fi
  local flags=(--device "$DEV" --resolution "$RES" --strength "$BLUR_STRENGTH")
  [ "$BLUR" = "on" ] || flags+=(--no-blur)
  exec "$PYTHON" "$BLUR_PY" "${flags[@]}"
}

case "$ACTION" in
setup)  do_setup ;;
stream) do_stream ;;
nudge)  do_nudge ;;
start)  do_setup && do_stream ;;
stop)
  # Tearing down this end is not enough: left alone the camera stays in webcam
  # mode, streaming to nobody, with its recording light on until the battery
  # goes. STOP ends the stream, exit leaves webcam mode. Plain HTTP, no root.
  ip=$(camera_ip)
  if [ -n "$ip" ]; then
    curl -s -m 5 "http://$ip/gp/gpWebcam/STOP"   >/dev/null 2>&1
    curl -s -m 5 "http://$ip/gopro/webcam/exit"  >/dev/null 2>&1
    state=$(curl -s -m 5 "http://$ip/gopro/webcam/status" 2>/dev/null \
            | grep -o '"status"[^,}]*' | grep -o '[0-9]*$')
    case "${state:-}" in
      0) green "Camera left webcam mode." ;;
      "") dim "Camera did not answer — it may already be unplugged." ;;
      *) red "Camera still reports webcam status $state; unplug it if the light stays on." ;;
    esac
  else
    dim "No camera interface found; skipping the camera half."
  fi

  # The GUI runs the stream as a transient user service; stop that first so
  # systemd does not treat the kill below as a crash.
  if [ "$(id -u)" -ne 0 ] && command -v systemctl >/dev/null; then
    systemctl --user stop gopro-panel-stream 2>/dev/null
  fi
  pid=$(worker_pid) && kill "$pid" 2>/dev/null
  as_root pkill -f "v4l2 $DEV" 2>/dev/null
  as_root pkill -f "gopro webcam" 2>/dev/null
  sleep 0.5
  as_root modprobe -rf v4l2loopback 2>/dev/null
  if lsmod 2>/dev/null | grep -q '^v4l2loopback'; then
    red "v4l2loopback would not unload — something still has $DEV open."
    dim "  sudo fuser -v $DEV     # to see what"
  else
    green "Stopped."
  fi
  ;;
status)
  if [ -e "$DEV" ]; then green "video: $DEV is up"
  else dim "video: not running"; fi
  if pid=$(worker_pid); then
    green "blur:  worker running as pid $pid (BLUR=$BLUR, strength $BLUR_STRENGTH)"
  else dim "blur:  no worker"; fi
  m=$(mic_source)
  echo
  dim "The camera's own microphone is not carried over this link — pick a mic separately."
  if [ -n "$m" ]; then green "  microphone: $m"
  elif [ -n "$MIC_MATCH" ]; then red "  microphone: nothing matching '$MIC_MATCH' is plugged in"
  else dim "  microphone: set MIC_MATCH in $CONFIG to have it named here"; fi
  dim "  camera:     $DEV"
  ;;
*)
  sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
  ;;
esac
